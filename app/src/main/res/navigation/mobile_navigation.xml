<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/home_nav_graph">

    <fragment
        android:id="@id/home_nav_graph"
        android:name="com.kuzmin.tm_4.feature.home.ui.fragments.HomeFragment"
        tools:layout="@layout/fragment_home"
        >

        <action
            android:id="@id/action_home_nav_graph_to_login_nav_graph"
            app:destination="@id/login_nav_graph" />
        <action
            android:id="@id/action_home_nav_graph_to_site_filter_nav_graph"
            app:destination="@id/site_filter_nav_graph" />
        <action
            android:id="@id/action_home_nav_graph_to_sites_nav_graph"
            app:destination="@id/sites_nav_graph" />
        <action
            android:id="@id/action_home_nav_graph_to_sites_local_nav_graph"
            app:destination="@id/sites_local_nav_graph" />
        <action
            android:id="@id/action_home_nav_graph_to_site_creation_nav_graph"
            app:destination="@id/site_creation_nav_graph" />
    </fragment>

    <fragment
        android:id="@id/sites_nav_graph"
        android:name="com.kuzmin.tm_4.feature.sites.ui.fragments.SiteListRemoteFragment"
        tools:layout="@layout/fragment_nav_sites" >
        <argument
            android:name="@string/filter"
            app:argType="boolean"
            android:defaultValue="false"/>
        <action
            android:id="@id/action_sites_nav_graph_to_report_nav_graph"
            app:destination="@id/report_nav_graph" />
        <action
            android:id="@id/action_sites_nav_graph_to_site_nav_graph"
            app:destination="@id/site_nav_graph" />
        <action
            android:id="@id/action_sites_nav_graph_to_site_creation_nav_graph"
            app:destination="@id/site_creation_nav_graph"
            app:launchSingleTop="true"
            app:popUpTo="@id/sites_nav_graph" />
    </fragment>

    <fragment
        android:id="@id/sites_local_nav_graph"
        android:name="com.kuzmin.tm_4.feature.sites.ui.fragments.SiteListLocalFragment"
        tools:layout="@layout/fragment_nav_sites"
        >
        <argument
            android:name="@string/filter"
            app:argType="boolean"
            android:defaultValue="false"/>
        <action
            android:id="@id/action_sites_local_nav_graph_to_site_nav_graph"
            app:destination="@id/site_nav_graph" />
        <action
            android:id="@id/action_sites_local_nav_graph_to_site_creation_nav_graph"
            app:destination="@id/site_creation_nav_graph" />
        <action
            android:id="@id/action_sites_local_nav_graph_to_report_nav_graph"
            app:destination="@id/report_nav_graph" />
    </fragment>

    <fragment
        android:id="@id/site_nav_graph"
        android:name="com.kuzmin.tm_4.feature.sites.ui.fragments.SingleSiteFragment"
        tools:layout="@layout/fragment_site"
        android:label="{title}"
        >
        <argument
            android:name="@string/title"
            app:argType="string"
            android:defaultValue=""/>
        <argument
            android:name="@string/site_uuid"
            app:argType="string"
            android:defaultValue="xxx" />
        <argument
            android:name="@string/construction_uuid"
            app:argType="string"
            android:defaultValue="xxx" />
        <argument
            android:name="@string/storage_type"
            app:argType="integer"
            android:defaultValue="-1" />
        <action
            android:id="@+id/action_site_nav_graph_to_measurements_nav_graph2"
            app:destination="@id/measurements_nav_graph" />

        <!--<action
            android:id="@id/action_site_nav_graph_to_measurements_nav_graph"
            app:destination="@id/measurements_nav_graph" />
        <action
            android:id="@id/action_site_nav_graph_to_report_nav_graph"
            app:destination="@id/report_nav_graph" />-->
    </fragment>

    <fragment
        android:id="@id/measurements_nav_graph"
        android:name="com.kuzmin.tm_4.feature.measurements.ui.NavMeasurementsFragment"
        tools:layout="@layout/fragment_nav_measurements" >
        <!--<action
            android:id="@+id/action_navigation_chat_to_single_chat"
            app:destination="@id/single_chat"
            app:popUpTo="@id/navigation_chat" />-->
        <action
            android:id="@id/action_measurements_nav_graph_to_report_nav_graph"
            app:destination="@id/report_nav_graph" />
        <action
            android:id="@+id/action_measurements_nav_graph_to_measurement_view_nav_graph"
            app:destination="@id/measurement_view_nav_graph" />
    </fragment>

    <fragment
        android:id="@id/report_nav_graph"
        android:name="com.kuzmin.tm_4.feature.report.ui.fragments.NavReportFragment"
        tools:layout="@layout/fragment_nav_report"
        >
        <argument
            android:name="mc_uuid"
            app:argType="string"
            android:defaultValue=""
            />
        <action
            android:id="@id/action_report_nav_graph_to_report_graphs"
            app:destination="@id/report_graphs" />
        <action
            android:id="@id/action_report_nav_graph_to_report_tables"
            app:destination="@id/report_tables" />

    </fragment>

    <fragment
        android:id="@id/report_graphs"
        android:name="com.kuzmin.tm_4.feature.report.ui.fragments.ReportGraphsPagerFragment"
        tools:layout="@layout/fragment_report_graphs_pager"
        >
        <argument
            android:name="mc_uuid"
            app:argType="string"
            android:defaultValue=""
            />

    </fragment>
    <fragment
        android:id="@id/report_tables"
        android:name="com.kuzmin.tm_4.feature.report.ui.fragments.ReportTablesPagerFragment"
        tools:layout="@layout/fragment_report_tables_pager"
        >
        <argument
            android:name="mc_uuid"
            app:argType="string"
            android:defaultValue=""
            />

    </fragment>

    <fragment
        android:id="@id/login_nav_graph"
        android:name="com.kuzmin.tm_4.feature.login.ui.LoginFragment"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@id/action_login_nav_graph_to_register_nav_graph"
            app:destination="@id/register_nav_graph" />
    </fragment>

    <fragment
        android:id="@id/register_nav_graph"
        android:name="com.kuzmin.tm_4.feature.login.ui.RegistrationFragment"
        tools:layout="@layout/fragment_registration"
        >

    </fragment>


    <fragment
        android:id="@id/site_filter_nav_graph"
        android:name="com.kuzmin.feature.site_filter.ui.fragments.SiteFilterFragment"
        tools:layout="@layout/fragment_site_filter">
        <argument
            android:name="@string/storage_type"
            app:argType="integer"
            android:defaultValue="5000"/>
    </fragment>

    <fragment
        android:id="@id/site_creation_nav_graph"
        android:name="com.kuzmin.tm_4.feature.site_creation.ui.fragments.SiteCreationMainFragment"
        tools:layout="@layout/fragment_site_creation_main">
        <argument
            android:name="@string/site_uuid"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null"
            />
        <action
            android:id="@id/action_site_creation_nav_graph_to_site_construction_creation_nav_graph"
            app:destination="@id/site_construction_creation_nav_graph"
            app:launchSingleTop="true"
            app:popUpTo="@id/site_creation_nav_graph" />

    </fragment>

    <fragment
        android:id="@id/site_construction_creation_nav_graph"
        android:name="com.kuzmin.tm_4.feature.site_creation.ui.fragments.ConstructionCreationFragment"
        tools:layout="@layout/fragment_construction_creation"
        >
        <argument
            android:name="@string/site_uuid"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null"
            />
    </fragment>

    <fragment
        android:id="@id/measurement_view_nav_graph"
        android:name="com.kuzmin.tm_4.feature.measurements.ui.TowerMeasurePagerFragment"
        tools:layout="@layout/fragment_tower_measure_pager"
        >
        <argument
            android:name="mc_uuid"
            app:argType="string"
            android:defaultValue=""
            />

        <action
            android:id="@+id/action_measurement_view_nav_graph_to_report_nav_graph"
            app:destination="@id/report_nav_graph" />
    </fragment>
</navigation>