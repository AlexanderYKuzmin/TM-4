<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="McCommonTextView" parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="McCommonTextViewValues" parent="McCommonTextView">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="McLevelsData" parent="Widget.MaterialComponents.TextView">
        <item name="android:gravity">center</item>
        <item name="android:layout_margin">6dp</item>
    </style>

    <style name="MeasureActionTabLayoutTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">18dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textScaleX">1.5</item>
        <item name="fontFamily">@font/local_titles</item>
        <item name="android:layout_gravity">start</item>
    </style>

    <style name="FabTowerMeasure" parent="Widget.Design.FloatingActionButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">@color/color_item_site_remote</item>
        <item name="android:tint">@color/color_on_surface</item>
        <item name="android:layout_margin">16dp</item>
    </style>
</resources>

