<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.ReportGraphsPagerFragment">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_graphs"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        app:tabIndicatorFullWidth="true"
        app:tabTextColor="@color/color_on_container"
        app:tabSelectedTextColor="@color/color_title"
        app:tabBackground="@color/color_container"
        app:tabIndicatorColor="@color/color_primary_dark"
        app:tabIndicatorAnimationMode="elastic"
        app:tabIndicatorHeight="48dp"
        app:tabTextAppearance="@style/ReportTabLayoutTextAppearance"
        />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_report_graphs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        />
</LinearLayout>