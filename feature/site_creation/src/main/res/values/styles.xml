<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextInputSiteCreation" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:textColorHint">@color/color_gray</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="ButtonAddConstructionStyle">

    </style>

    <style name="FabSiteCreation" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:backgroundTint">@color/color_gray_light</item>
        <item name="android:layout_weight">1</item>
        <item name="tint">@color/color_on_surface</item>
        <item name="android:layout_margin">16dp</item>
    </style>

    <style name="HintBorderTextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">2dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:background">@color/white</item>
        <item name="android:textColor">@color/color_primary</item>
    </style>
</resources>