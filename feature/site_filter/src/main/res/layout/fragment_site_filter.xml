<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background"
    tools:context=".ui.fragments.SiteFilterFragment">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="45dp"
        android:layout_marginEnd="30dp"
        android:layout_marginStart="30dp"
        android:layout_gravity="center"
        app:cardElevation="20dp"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            >

        <TextView
            android:id="@+id/tv_title_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:gravity="center_horizontal"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/local_titles"
            android:text="@string/filter_title"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:id="@+id/til_start_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColorHint="@color/color_gray"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title_filter"
            app:layout_constraintEnd_toStartOf="@id/til_end_date"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_start_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16dp"
                android:fontFamily="@font/naga"
                android:hint="@string/start_date"
                />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_end_date"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColorHint="@color/color_gray"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintTop_toTopOf="@id/til_start_date"
            app:layout_constraintStart_toEndOf="@id/til_start_date"
            app:layout_constraintEnd_toEndOf="parent"
            >
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_end_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16dp"
                android:fontFamily="@font/naga"
                android:hint="@string/end_date"
                />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_region_filter"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColorHint="@color/color_gray"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/til_start_date"
            app:layout_constraintStart_toStartOf="@id/til_start_date"
            app:layout_constraintEnd_toStartOf="@id/til_city_filter"
            >
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_region_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16dp"
                android:fontFamily="@font/naga"
                android:hint="@string/region"
                />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_city_filter"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColorHint="@color/color_gray"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintTop_toTopOf="@id/til_region_filter"
            app:layout_constraintStart_toEndOf="@id/til_region_filter"
            app:layout_constraintBottom_toBottomOf="@id/til_region_filter"
            app:layout_constraintEnd_toEndOf="parent"
            >
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_city_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16dp"
                android:fontFamily="@font/naga"
                android:hint="@string/city"
                />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_name_filter"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:textColorHint="@color/color_gray"
            app:layout_constraintTop_toBottomOf="@id/til_region_filter"
            app:layout_constraintStart_toStartOf="@id/til_region_filter"
            app:layout_constraintEnd_toEndOf="@id/til_city_filter"
            >
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_name_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16dp"
                android:fontFamily="@font/naga"
                android:hint="@string/site_name"
                />
        </com.google.android.material.textfield.TextInputLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_search_filter"
                style="@style/ButtonFilterStyle"
                android:text="@string/search_btn"
                android:layout_marginStart="6dp"
                app:layout_constraintTop_toTopOf="@id/btn_cancel_filter"
                app:layout_constraintStart_toEndOf="@id/btn_cancel_filter"
                app:layout_constraintBottom_toBottomOf="@id/btn_cancel_filter"
                app:layout_constraintEnd_toEndOf="@id/til_name_filter"
                />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_cancel_filter"
                style="@style/ButtonFilterStyle"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:layout_marginEnd="6dp"
                android:text="@string/cancel_btn"
                app:layout_constraintStart_toStartOf="@id/til_name_filter"
                app:layout_constraintEnd_toStartOf="@id/btn_search_filter"
                app:layout_constraintTop_toBottomOf="@id/til_name_filter"
                app:layout_constraintBottom_toBottomOf="parent"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>