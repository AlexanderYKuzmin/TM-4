<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    tools:context=".ui.LoginFragment"
    android:background="@drawable/tower_blur"
    >

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardElevation="20dp"
         >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="45dp"
                android:textSize="24dp"
                android:textStyle="bold"
                android:fontFamily="@font/local_titles"
                android:text="@string/authorization"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_username"
                style="@style/TextInputLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:textSize="22dp"
                    android:fontFamily="@font/cuyabra"
                    android:hint="@string/username_hint"
                    android:inputType="textEmailAddress"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_password"
                style="@style/TextInputLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:textSize="22dp"
                    android:fontFamily="@font/cuyabra"
                    android:hint="@string/password_hint"
                    android:inputType="textPassword"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="24dp"
                android:layout_marginTop="24dp"
                >

                <CheckBox
                    android:id="@+id/chb_rem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/checkbox_remember"
                    android:textSize="16sp"
                    android:layout_marginEnd="12dp"
                    />

                <TextView
                    android:id="@+id/tv_register"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_click_register"
                    android:textColor="@color/color_accent"
                    android:textStyle="bold"
                    android:gravity="end"
                    android:textSize="16sp"
                    android:lines="1"
                    android:clickable="true"
                    />

            </LinearLayout>

            <include
                android:id="@+id/ll_btns_login"
                layout="@layout/handle_btn_block_layout"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>

    <!--android:hint="Имя пользователя"-->

    <!--style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"-->